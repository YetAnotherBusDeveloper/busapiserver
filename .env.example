# Required to synchronize transit data from TDX.
TDX_CLIENT_ID=your_client_id
TDX_CLIENT_SECRET=your_client_secret

# Web clients allowed to call this API. Keep the production origin and use the
# fixed localhost port below when running YABus with `--web-port 8080`.
CORS_ORIGINS=https://busapp.avianjay.sbs,http://localhost:8080,http://127.0.0.1:8080
